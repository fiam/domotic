# ==============================================================================
# Domotic Infrastructure Configuration
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values

# ==============================================================================
# Cloudflare Configuration
# ==============================================================================

# The account ID and Cloudflare token are loaded from encrypted bootstrap
# state. Never put either credential or the state passphrase in this file.

# Domain managed by Cloudflare
cloudflare_domain = "example.com"

# Subdomain for Home Assistant (will create homeassistant.example.com)
cloudflare_homeassistant_subdomain = "homeassistant"

# Friendly name for the tunnel
cloudflare_tunnel_name = "domotic-tunnel"

# Hostnames matched by the two local Gateway API HTTPRoutes. On k3s, advertise
# these with Avahi. For Kind, add them to the development machine's /etc/hosts.
local_http_hostnames = {
  homeassistant = "homeassistant.local"
  zigbee2mqtt   = "zigbee2mqtt.local"
}

# Client-facing URLs default to http://<hostname>. Override them when a
# development Gateway is published on another port, such as Kind's 8080.
# local_http_urls = {
#   homeassistant = "http://homeassistant.local:8080"
#   zigbee2mqtt   = "http://zigbee2mqtt.local:8080"
# }

# Use restore before the first Helm deployment when importing a native Home
# Assistant backup. It writes only a temporary minimal configuration so Home
# Assistant can present Upload backup; the restored /config then takes over.
homeassistant_bootstrap_mode = "seed" # or "restore"

# OpenTofu generates the initial owner password and retains it in encrypted
# state. These optional profile fields are not secret.
# homeassistant_owner = {
#   name     = "Home Administrator"
#   username = "admin"
#   language = "en"
# }

# Optional custom integrations selected by this deployment. Use a public,
# immutable repository or release tar.gz and verify its digest independently.
# The URL and checksum are written to non-secret Helm values, so never put a
# token or signed credential in the URL. name is the Home Assistant integration
# domain and may contain underscores. archive_path is the directory inside the
# archive that directly contains manifest.json.
# homeassistant_remote_custom_components = [{
#   name         = "example_integration"
#   url          = "https://github.com/example/integration/archive/0123456789abcdef.tar.gz"
#   sha256       = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
#   archive_path = "integration-0123456789abcdef/custom_components/example_integration"
# }]

# ==============================================================================
# Home Assistant backups
# ==============================================================================

# Bootstrap creates the dedicated backup bucket and supplies its scoped
# credential automatically.
# homeassistant_r2_backup_prefix = "home-assistant"

# With an R2 bucket, seed mode configures daily R2 backups automatically and
# retains seven copies. Omit this block for those defaults. A null time uses
# Home Assistant's randomized early-morning schedule; later changes made in
# Home Assistant are preserved.
# homeassistant_automatic_backups = {
#   enabled          = true
#   retention_copies = 7
#   time             = null # or "03:30:00"
# }

# Native backups are unencrypted by default. When enabled, OpenTofu generates
# the backup password and retains it in encrypted state.
# homeassistant_backup_encryption_enabled = true

# ==============================================================================
# Kubernetes Configuration
# ==============================================================================

# Namespace where Helm charts will be deployed
kubernetes_namespace = "domotic"

# Helm release name (affects service DNS names)
helm_release_name = "domotic"

# ==============================================================================
# Zigbee Configuration
# ==============================================================================

# OpenTofu generates the network key and extended PAN ID and retains them in
# encrypted state. Use the documented Zigbee import task before the first
# deployment when adopting an existing network.
# Do not put real keys in this main configuration file.

# Network settings - PROTECTED (changing breaks paired devices)
# These are stored in a ConfigMap (non-sensitive) but still protected
zigbee_pan_id  = 6754  # PAN ID (0-65535)
zigbee_channel = 15    # Zigbee channel (11-26, avoid WiFi overlap: use 15, 20, or 25)

# ==============================================================================
# Safety Settings (Advanced)
# ==============================================================================

# DANGER: Only set to true if you intentionally want to change network keys
# This will break your entire Zigbee network and require re-pairing all devices!
# force_update_secrets = false
