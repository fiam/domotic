# ==============================================================================
# Domotic Infrastructure Configuration
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values

# ==============================================================================
# Cloudflare Configuration
# ==============================================================================

# Create an account-owned token under Manage Account > Account API Tokens.
# Required policies:
#   - Entire Account / Cloudflare One Connector: cloudflared / Edit
#   - Specified Domains / Zone / Read
#   - Specified Domains / DNS / Edit
# Add Entire Account / Workers R2 Storage / Read and Write when enabling R2.
cloudflare_api_token = "<your-cloudflare-api-token>"

# The token's 32-character ID, not its cfat_ secret. Required only for R2.
# Obtain it after creating the token:
#   curl -fsS "https://api.cloudflare.com/client/v4/accounts/<account-id>/tokens/verify" \
#     -H "Authorization: Bearer <token>" | jq -r .result.id
# cloudflare_api_token_id = "<your-account-api-token-id>"

# Your Cloudflare account ID (found in dashboard)
cloudflare_account_id = "<your-account-id>"

# Domain managed by Cloudflare
cloudflare_domain = "example.com"

# Subdomain for Home Assistant (will create homeassistant.example.com)
cloudflare_homeassistant_subdomain = "homeassistant"

# Friendly name for the tunnel
cloudflare_tunnel_name = "domotic-tunnel"

# Hostnames matched by the two local Gateway API HTTPRoutes. On k3s, advertise
# these with Avahi. For Kind, add them to the development machine's /etc/hosts.
local_http_hostnames = {
  homeassistant = "homeassistant.local"
  zigbee2mqtt   = "zigbee2mqtt.local"
}

# Client-facing URLs default to http://<hostname>. Override them when a
# development Gateway is published on another port, such as Kind's 8080.
# local_http_urls = {
#   homeassistant = "http://homeassistant.local:8080"
#   zigbee2mqtt   = "http://zigbee2mqtt.local:8080"
# }

# Use restore before the first Helm deployment when importing a native Home
# Assistant backup. It writes only a temporary minimal configuration so Home
# Assistant can present Upload backup; the restored /config then takes over.
homeassistant_bootstrap_mode = "seed" # or "restore"

# Optional first-boot owner account in seed mode. Terraform stores these values
# in a Kubernetes Secret and Helm completes Home Assistant's built-in but
# undocumented onboarding HTTP flow. Existing users and completed onboarding
# are never overwritten. Read HOME_ASSISTANT_COMPATIBILITY.md before upgrades.
# homeassistant_onboarding = {
#   name     = "Home Administrator"
#   username = "admin"
#   password = "replace-with-a-long-unique-password"
#   language = "en"
# }

# ==============================================================================
# Encrypted R2 Backups (Optional)
# ==============================================================================

# The Cloudflare API token above also needs Account / Workers R2 Storage Read
# and Write.
# Bucket names are unique within your Cloudflare account.
# r2_backup_bucket_name = "domotic-backups"
# r2_backup_location    = "weur"
# homeassistant_r2_backup_prefix = "home-assistant"

# With an R2 bucket and homeassistant_onboarding, seed mode configures daily,
# encrypted R2 backups automatically and retains seven copies. Omit this block
# for those defaults. A null time uses Home Assistant's randomized early-morning
# schedule; later changes made in Home Assistant are preserved.
# homeassistant_automatic_backups = {
#   enabled          = true
#   retention_copies = 7
#   time             = null # or "03:30:00"
# }

# Terraform generates a separate 32-character native-backup password by
# default. Set one only when importing an existing recovery password, and keep
# it in this ignored file or another protected Terraform variable source.
# homeassistant_backup_password = "replace-with-an-existing-recovery-password"

# ==============================================================================
# Kubernetes Configuration
# ==============================================================================

# Namespace where Helm charts will be deployed
kubernetes_namespace = "domotic"

# Helm release name (affects service DNS names)
helm_release_name = "domotic"

# ==============================================================================
# Zigbee Configuration
# ==============================================================================

# Generate keys on the first apply. The apply task immediately captures them in
# the ignored, mode-0600 zigbee-keys.tfvars.json file. Subsequent Task runs load
# that file after this one, where it disables generation and supplies the keys.
generate_zigbee_keys = true

# For a migration, import a previously backed-up key file before applying:
#   task keys:import SOURCE=/path/to/zigbee-keys.tfvars.json
# Do not put real keys in this main configuration file.

# Network settings - PROTECTED (changing breaks paired devices)
# These are stored in a ConfigMap (non-sensitive) but still protected
zigbee_pan_id  = 6754  # PAN ID (0-65535)
zigbee_channel = 15    # Zigbee channel (11-26, avoid WiFi overlap: use 15, 20, or 25)

# ==============================================================================
# Safety Settings (Advanced)
# ==============================================================================

# DANGER: Only set to true if you intentionally want to change network keys
# This will break your entire Zigbee network and require re-pairing all devices!
# force_update_secrets = false
