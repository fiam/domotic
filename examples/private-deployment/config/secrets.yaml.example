# Copy this file to secrets.yaml, replace the required values, encrypt it to
# secrets.sops.yaml with SOPS, and remove the plaintext copy immediately.
CLOUDFLARE_API_TOKEN: replace-with-cloudflare-api-token
HOMEASSISTANT_ADMIN_PASSWORD: replace-with-home-assistant-admin-password

# Optional. Omit this to create unencrypted native backups in the private R2
# bucket. Set it to enable native backup encryption.
# HOMEASSISTANT_BACKUP_PASSWORD: replace-with-home-assistant-backup-password
