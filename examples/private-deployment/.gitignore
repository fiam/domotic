.DS_Store

# Materialized, commit-pinned public source.
/.domotic/
/.task/

# Generated runtime files.
/config/infra/helm-values.yaml
/config/infra/zigbee-keys.tfvars.json
/config/restore/

# Never commit plaintext credential files.
/config/secrets.yaml

# The bootstrap state is encrypted by OpenTofu and intentionally committed.
/state/*
!/state/bootstrap.tfstate
