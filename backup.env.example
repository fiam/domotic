# Copy to backup.env and keep the resulting file private (chmod 0600).
# Store these credentials and the age identity in an independent password
# manager; they are required to recover backups if this workstation is lost.

R2_ACCOUNT_ID=
R2_BUCKET=domotic-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=domotic

# Public recipient printed by age-keygen. This is safe to disclose.
R2_AGE_RECIPIENT=

# Required only for restores. Use an absolute path to the separately stored key.
R2_AGE_IDENTITY_FILE=
