# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Submodule repositories contribute only their Home Assistant component source.
charts/homeassistant/files/repositories/*/.git
charts/homeassistant/files/repositories/*/.github/
charts/homeassistant/files/repositories/*/.gitignore
charts/homeassistant/files/repositories/*/README.md
charts/homeassistant/files/repositories/*/Taskfile.yml
charts/homeassistant/files/repositories/*/hacs.json
charts/homeassistant/files/repositories/*/tests/
charts/homeassistant/files/repositories/*/custom integration_emulator/
